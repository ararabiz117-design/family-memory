# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local environment and secret-bearing files
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
android/key.properties
ios/Runner/*.p12
ios/Runner/*.mobileprovision

# Generated release evidence and sensitive exports
/output/
/docs/verification/*.json
/docs/verification/*.csv
/docs/verification/*.png
/docs/verification/*.sha256

# Private local backend state, credentials and distributable archives
node_modules/
.wrangler/
cloudflare/dist/
cloudflare/.dev.vars
cloudflare/.dev.vars.*
!cloudflare/.dev.vars.example
cloudflare/wrangler.production.jsonc
/release/
/docs/PLAY_CONSOLE_HANDOFF.md
/docs/verification/
