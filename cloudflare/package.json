{
  "name": "family-memory-api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:runtime": "node scripts/workerd-smoke.mjs",
    "db:local": "wrangler d1 migrations apply family-memory --local",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
